[Unit]
Description=居家老人安全监测 — YAMNet 声音识别上报服务
Documentation=https://eldersafe-fv6io3sc.manus.space
# 等待网络和音频设备就绪后再启动
After=network-online.target sound.target
Wants=network-online.target
# 最多重试 5 次，之后等 5 分钟再试
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi

# MD5 自检：开机时校验脚本完整性，防止被意外覆盖回旧版本
ExecStartPre=/bin/bash -c '\
  EXPECTED="160e79ec7d015665ab8406d431082a0c"; \
  ACTUAL=$(md5sum /home/pi/yamnet_uploader.py | cut -d" " -f1); \
  if [ "$ACTUAL" != "$EXPECTED" ]; then \
    echo "[ALERT] yamnet_uploader.py MD5 mismatch! Expected: $EXPECTED, Got: $ACTUAL"; \
    echo "[ALERT] Script may have been modified or reverted. Service will still start."; \
  else \
    echo "[OK] yamnet_uploader.py MD5 verified: $ACTUAL"; \
  fi'

# 主程序命令
ExecStart=/home/pi/yamnet_venv/bin/python3 /home/pi/yamnet_uploader.py \
    --device-id rpi-001 \
    --api-token 116b9075617e5a0f5a2591ca967d93e68ba321063e5d03d1773a3fd53202d470 \
    --server-url https://eldersafe-fv6io3sc.manus.space \
    --model /home/pi/yamnet.tflite \
    --mic-device 3

# 异常退出后 10 秒自动重启
Restart=on-failure
RestartSec=10

# 标准输出和错误都写入日志
StandardOutput=append:/var/log/yamnet-monitor.log
StandardError=append:/var/log/yamnet-monitor.log

# 环境变量
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
